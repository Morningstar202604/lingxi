# ── 智犀 ZhiXi 环境变量示例 ──
# 复制为 .env 后按需修改（.env 已在 .gitignore，不会入库）。
# 桌面版也可写到 %APPDATA%\lingxi\lingxi.env（由 Tauri 壳传入数据目录）。

# ============ 大模型（必配其一）============
# 云端 API 优先（推荐）——以 DeepSeek 为例：
#LINGXI_LLM__PROVIDER=deepseek
#LINGXI_LLM__MODEL=deepseek-chat
#LINGXI_LLM__API_KEY=<到 platform.deepseek.com 申请>
#LINGXI_LLM__BASE_URL=https://api.deepseek.com
#
# 通义千问（DashScope OpenAI 兼容）:
#LINGXI_LLM__MODEL=qwen-plus
#LINGXI_LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# 智谱 GLM（有免费档位）:
#LINGXI_LLM__MODEL=glm-4-flash
#LINGXI_LLM__BASE_URL=https://open.bigmodel.cn/api/paas/v4
#
# 本地模型（可选；装好 Ollama 后即为默认配置，无需改动本文件）:
#LINGXI_LLM__PROVIDER=ollama
#LINGXI_LLM__MODEL=qwen2.5:7b
#LINGXI_LLM__BASE_URL=http://127.0.0.1:11434/v1

# ============ 管理凭据（生产必配）============
# 未配置时仅 loopback 本机可匿名访问管理面；监听 0.0.0.0 则 fail-closed
#LINGXI_SECURITY__ADMIN_TOKEN=<≥16 位随机串>

# ============ IM 桥接 ============
#LINGXI_ONEBOT__WS_URL=ws://127.0.0.1:3001
#LINGXI_GEWECHAT__ENABLED=false

# ============ 持久化（可选升级）============
#LINGXI_PERSISTENCE__BACKEND=sqlite          # sqlite | postgresql | memory
#LINGXI_PERSISTENCE__POSTGRES__DSN=postgresql://zhixi:zhixi@localhost:5432/zhixi

# ============ 语义记忆 / 图谱（可选）============
#LINGXI_MEM0__ENABLED=true                   # 需 Ollama（nomic-embed-text）
#LINGXI_NEO4J__ENABLED=true                  # 需 Neo4j 5 服务
#LINGXI_NEO4J__URI=bolt://127.0.0.1:7687

# ============ 入站 Webhook 验签（可选）============
#LINGXI_WEBHOOK__INBOUND_HMAC_SECRET=<≥32 字符随机值>

# ============ 其它 ============
#LINGXI_DEBUG=false
#LINGXI_LOG_LEVEL=INFO
