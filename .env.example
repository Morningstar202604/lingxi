# ── 智犀 ZhiXi 环境变量示例 ──
# 复制为 .env 后按需修改（.env 已在 .gitignore，不会入库）。
# 桌面版也可写到 %APPDATA%\lingxi\lingxi.env（由 Tauri 壳传入数据目录）。

# ============ 大模型（必配其一）============
# 云端 API 优先（推荐）——以 DeepSeek 为例：
#LINGXI_LLM__PROVIDER=deepseek
#LINGXI_LLM__MODEL=deepseek-chat
#LINGXI_LLM__API_KEY=<到 platform.deepseek.com 申请>
#LINGXI_LLM__BASE_URL=https://api.deepseek.com
#
# 通义千问（DashScope OpenAI 兼容）:
#LINGXI_LLM__MODEL=qwen-plus
#LINGXI_LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# 智谱 GLM（有免费档位）:
#LINGXI_LLM__MODEL=glm-4-flash
#LINGXI_LLM__BASE_URL=https://open.bigmodel.cn/api/paas/v4
#
# 本地模型（可选；装好 Ollama 后即为默认配置，无需改动本文件）:
#LINGXI_LLM__PROVIDER=ollama
#LINGXI_LLM__MODEL=qwen2.5:7b
#LINGXI_LLM__BASE_URL=http://127.0.0.1:11434/v1

# ============ 管理凭据（生产必配）============
# 未配置时仅 loopback 本机可匿名访问管理面；监听 0.0.0.0 则 fail-closed
#LINGXI_SECURITY__ADMIN_TOKEN=<≥16 位随机串>

# ============ IM 桥接 ============
#LINGXI_ONEBOT__WS_URL=ws://127.0.0.1:3001
#LINGXI_GEWECHAT__ENABLED=false

# ============ 持久化（可选升级）============
#LINGXI_PERSISTENCE__BACKEND=sqlite          # sqlite | postgresql | memory
#LINGXI_PERSISTENCE__POSTGRES__DSN=postgresql://zhixi:zhixi@localhost:5432/zhixi

# ============ 语义记忆 / 图谱（可选）============
#LINGXI_MEM0__ENABLED=true                   # 需 Ollama（nomic-embed-text）
#LINGXI_NEO4J__ENABLED=true                  # 需 Neo4j 5 服务
#LINGXI_NEO4J__URI=bolt://127.0.0.1:7687

# ============ 入站 Webhook 验签（可选）============
#LINGXI_WEBHOOK__INBOUND_HMAC_SECRET=<≥32 字符随机值>

# ============ LLM 响应缓存（可选）============
# 相同 prompt 直接命中缓存：省 token、省延迟（本地模型收益最大）
#LINGXI_LLM_CACHE__ENABLED=true
#LINGXI_LLM_CACHE__BACKEND=disk          # disk | redis
#LINGXI_LLM_CACHE__TTL_SECONDS=3600

# ============ HTTP 限流（默认开启）============
# 只限重端点（LLM 推理 / 知识库写入），读类轮询端点不限
#LINGXI_RATELIMIT__ENABLED=false
#LINGXI_RATELIMIT__HEAVY=30/minute

# ============ 检索重排（可选，本地模型）============
# 装 flashrank；模型首次自动下载（受限网络可预置到 data/rerank_models/）
#LINGXI_KNOWLEDGE__RERANK_ENABLED=true
#LINGXI_KNOWLEDGE__RERANK_MODEL=ms-marco-MiniLM-L-12-v2

# ============ Shell 沙箱（Docker 隔离，默认开）============
# 需要执行 shell 命令时强烈建议保持启用；Docker 不可用会自动降级并告警
#LINGXI_SANDBOX__ENABLED=true
#LINGXI_SANDBOX__IMAGE=alpine:3.20
#LINGXI_SANDBOX__MOUNT_DIR=           # 挂载目录（默认不挂，且只读）
#LINGXI_SANDBOX__WRITABLE=false
#LINGXI_SANDBOX__NETWORK=none         # none | bridge
#LINGXI_SANDBOX__MEMORY=512m
#LINGXI_SANDBOX__TIMEOUT_SECONDS=30

# ============ 多凭据 / 熔断 / 成本预算（litellm Router）============
# 配了额外 key（或 ROUTER_ENABLED=true）才启用；单 key 场景无必要
#LINGXI_LLM__ROUTER_ENABLED=false
#LINGXI_LLM__API_KEYS=["<额外key1>","<额外key2>"]
#LINGXI_LLM__ROUTING_STRATEGY=simple-shuffle   # 或 least-busy / latency-based-routing
#LINGXI_LLM__ALLOWED_FAILS=3
#LINGXI_LLM__COOLDOWN_TIME=60
#LINGXI_LLM__MAX_BUDGET_USD=10                  # 超预算阻断调用
#LINGXI_LLM__BUDGET_DURATION=30d

# ============ LLM 追踪（可选，默认关）============
# LangSmith:
#LANGCHAIN_TRACING_V2=true
#LANGCHAIN_API_KEY=<key>
# 任意 OTLP 后端（Jaeger/Tempo/Grafana/Datadog）:
#OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# ============ 其它 ============
#LINGXI_DEBUG=false
#LINGXI_LOG_LEVEL=INFO
