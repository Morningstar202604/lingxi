{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "智犀",
  "version": "0.2.0",
  "identifier": "com.zhixi.engine",
  "build": {
    "beforeDevCommand": "cd web && npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node src-tauri/tauri-web-build.mjs",
    "frontendDist": "../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "智犀 ZhiXi",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["lingxi-server"]
  },
  "plugins": {
    "shell": {},
    "process": {},
    "fs": {
      "requireLiteralLeadingDot": false,
      "scopeDroppedPaths": false
    }
  }
}